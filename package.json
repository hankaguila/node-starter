{
  "name": "node-starter",
  "version": "0.3.1",
  "author": "Hank Aguila",
  "files": [
    "build"
  ],
  "main": "build/main.js",
  "types": "build/main.d.ts",
  "type": "module",
  "scripts": {
    "exec": "tsx",
    "test": "vitest --dir=test run",
    "build": "tsup src/main.ts --clean -d=build --dts --format=esm --platform=node --sourcemap --target=node20",
    "deps:check": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u && npm i"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/node": "^24.5.2",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
