{
  "name": "ts-starter",
  "version": "0.2.1",
  "author": "Henry Aguila",
  "files": [
    "build"
  ],
  "main": "build/main.js",
  "types": "build/main.d.ts",
  "type": "module",
  "scripts": {
    "ts": "tsx",
    "test": "vitest --dir=test run",
    "build": "shx rm -rf build && tsup src/main.ts -d=build --dts --format=esm",
    "update:check": "npx npm-check-updates",
    "update": "npx npm-check-updates -u && npm i"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@types/node": "^22.13.5",
    "prettier": "^3.5.2",
    "shx": "^0.3.4",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
