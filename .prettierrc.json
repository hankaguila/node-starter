{
  "printWidth": 100,
  "trailingComma": "none",
  "vueIndentScriptAndStyle": true,
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": [
    "<TYPES>^(node:)",
    "<TYPES>",
    "<TYPES>^[$]",
    "<TYPES>^[.]",
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "^[$]",
    "^[.]"
  ],
  "importOrderCaseSensitive": true
}
